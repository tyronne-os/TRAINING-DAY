# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── AVTR-1 renderer (separate process, started via pixi) ──────────────────────
AVTR1_RENDERER_URL=http://localhost:8000

# Path to AVTR-1 reference_frames dir (copy evedefault portrait here)
AVTR1_FRAMES_DIR=./checkpoints/avtr1/avatars_artifacts/reference_frames

# ── Avatars ───────────────────────────────────────────────────────────────────
AVATARS_DIR=./avatars

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
